[flake8]
max-line-length = 88
extend-ignore = D100,D101,D103,D104,E203,E701
docstring-convention = google
# Emacs lock/auto-save files (see .gitignore), and add_area/scripts, which holds
# standalone scripts kept close to their original form.
extend-exclude = .#*,#*#,*~,usl_pipeline/add_area/scripts
