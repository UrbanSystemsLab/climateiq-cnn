[
  {
    "service": "usl_lib",
    "path": "usl_pipeline/usl_lib",
    "runner": "ubuntu-22.04",
    "gdal": true,
    "emulator": true,
    "pytest": true,
    "deps": "usl_pipeline/usl_lib/setup.py",
    "install": "pip install -e usl_pipeline/usl_lib[dev]"
  },
  {
    "service": "add_area",
    "path": "usl_pipeline/1_add_area",
    "runner": "ubuntu-22.04",
    "gdal": true,
    "emulator": false,
    "pytest": true,
    "deps": "requirements-dev.txt\nusl_pipeline/1_add_area/requirements.txt\nusl_pipeline/usl_lib/setup.py",
    "install": "pip install -r requirements-dev.txt && cd usl_pipeline/1_add_area && pip install -r requirements.txt GDAL==3.6.4 --extra-index-url https://code.usgs.gov/api/v4/groups/859/-/packages/pypi/simple"
  },
  {
    "service": "preprocessing",
    "path": "usl_pipeline/2_preprocessing",
    "mypy_path": "usl_pipeline/usl_lib",
    "runner": "ubuntu-24.04",
    "gdal": false,
    "emulator": false,
    "pytest": true,
    "deps": "requirements-dev.txt\nusl_pipeline/2_preprocessing/requirements.txt\nusl_pipeline/usl_lib/setup.py",
    "install": "pip install -r requirements-dev.txt && cd usl_pipeline/2_preprocessing && pip install -r requirements.txt && pip install --no-deps -e ../usl_lib"
  },
  {
    "service": "postprocessing",
    "path": "usl_pipeline/4_postprocessing",
    "mypy_path": "usl_pipeline/usl_lib",
    "runner": "ubuntu-24.04",
    "gdal": false,
    "emulator": false,
    "pytest": true,
    "deps": "requirements-dev.txt\nusl_pipeline/4_postprocessing/requirements.txt\nusl_pipeline/usl_lib/setup.py",
    "install": "pip install -r requirements-dev.txt && cd usl_pipeline/4_postprocessing && pip install -r requirements.txt && pip install --no-deps -e ../usl_lib"
  },
  {
    "service": "usl_models",
    "path": "usl_models",
    "runner": "ubuntu-24.04",
    "gdal": false,
    "emulator": true,
    "pytest": true,
    "deps": "usl_models/setup.py",
    "install": "pip install -e usl_models[dev]"
