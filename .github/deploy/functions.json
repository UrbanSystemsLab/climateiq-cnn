{
  "region": "us-central1",
  "groups": {
    "pipeline": {
      "description": "Data pipeline Cloud Functions (gen2). Infra is owned by climateiq-terraform/modules/data_pipeline; only code is deployed from here.",
      "source": "usl_pipeline/cloud_functions",
      "stage": "scripts/stage_cloud_functions.sh",
      "runtime": "python311",
      "functions": {
        "write-citycat-config-data": {"entry_point": "write_flood_scenario_metadata_and_features", "memory": "512Mi", "timeout": 60},
        "delete-citycat-config-metadata": {"entry_point": "delete_flood_scenario_metadata", "memory": "512Mi", "timeout": 60},
        "write-processed-citycat-labels": {"entry_point": "process_citycat_outputs", "memory": "4Gi", "timeout": 540},
        "generate-feature-matrix": {"entry_point": "build_heat_feature_matrix", "memory": "4Gi", "timeout": 540},
        "generate-flood-feature-matrix": {"entry_point": "build_flood_feature_matrix", "memory": "8Gi", "timeout": 540},
        "generate-feature-matrix-http": {"entry_point": "build_feature_matrix_http", "memory": "4Gi", "timeout": 540},
        "build-wrf-label-matrix": {"entry_point": "build_wrf_label_matrix", "memory": "4Gi", "timeout": 540},
        "build-wrf-label-matrix-http": {"entry_point": "build_wrf_label_matrix_http", "memory": "4Gi", "timeout": 540},
        "upload-wrf-study-area-chunk": {"entry_point": "build_and_upload_study_area_chunk", "memory": "512Mi", "timeout": 60},
        "rescale-feature-matrix": {"entry_point": "rescale_feature_matrices", "memory": "4Gi", "timeout": 540},
        "write-study-area-metadata": {"entry_point": "write_study_area_metadata", "memory": "512Mi", "timeout": 60},
        "write-wrf-heat-config-metadata": {"entry_point": "write_heat_scenario_config_metadata", "memory": "512Mi", "timeout": 60},
        "h3-pipeline": {"entry_point": "process_h3_pipeline", "memory": "32Gi", "timeout": 3600},
        "h3-pipeline-tiff-trigger": {"entry_point": "process_h3_pipeline_on_tiff_upload", "memory": "32Gi", "timeout": 3600},
        "h3-tile-publish": {"entry_point": "publish_tiles", "memory": "4Gi", "timeout": 3600}
      }
    }
  }
}
